{
  "name": "verboo-bridge",
  "version": "1.4.3",
  "type": "module",
  "description": "MCP server to use Verboo AI models as sub-agents in Claude Code, Codex, Cursor, or any MCP-compatible client",
  "keywords": [
    "verboo",
    "mcp",
    "claude",
    "codex",
    "ai",
    "models",
    "bridge"
  ],
  "homepage": "https://github.com/nikolasdehor/verboo-bridge",
  "license": "MIT",
  "author": "Nikolas de Hor (https://github.com/nikolasdehor)",
  "bin": {
    "verboo-bridge": "index.mjs",
    "verboo-mcp": "bin/verboo-mcp",
    "verboo-install-instructions": "bin/verboo-install-instructions.mjs",
    "vb": "bin/vb"
  },
  "files": [
    "index.mjs",
    "agent-runner.mjs",
    "job-queue.mjs",
    "memory-store.mjs",
    "model-router.mjs",
    "bin/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test && bash -n bin/vb bin/verboo-mcp && node --check index.mjs && node --check agent-runner.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "overrides": {
    "@hono/node-server": ">=2.0.5"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikolasdehor/verboo-bridge.git"
  }
}
